# ===== 敏感配置示例：复制为 .env 后填写，.env 不提交 =====
WSY_USERNAME=your_username_here
WSY_PASSWORD=your_password_here

# 备用网商园账号（config.yaml 中 wangshangyuan.account_index: 2 时启用）
WSY_USERNAME_2=your_backup_username_here
WSY_PASSWORD_2=your_backup_password_here

XY_USERNAME=your_xianyu_account_here
XY_PASSWORD=your_xianyu_password_here

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=change_me_random_string
